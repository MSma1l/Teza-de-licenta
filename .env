# =========================================================
# CONFIG LOCAL — nu commit-ui acest fisier (e in .gitignore)
# =========================================================

# IP-ul WiFi al laptopului tau (detectat automat: adaptor "Wireless / Wi-Fi")
# Telefonul cu Expo Go trebuie sa fie pe ACEEASI retea WiFi.
#
# Re-detectare manuala: PowerShell
#   Get-NetIPAddress -AddressFamily IPv4 | ? { $_.PrefixOrigin -eq 'Dhcp' }
LAN_IP=192.168.1.11

# Mod conectare Expo:
#   "tunnel" — prin ngrok, OCOLESTE limitarea Docker Desktop pe Windows
#              (Docker Desktop nu expune porturile pe IP-ul WiFi, doar localhost,
#              deci LAN direct NU merge fara port forwarding manual). [folosit]
#   "lan"    — DOAR daca rulezi expo nativ (fara Docker) sau pe Linux/Mac.
EXPO_DEV_MODE=tunnel
