# === Database ===
DATABASE_URL=postgresql+asyncpg://ai_contabil:ai_contabil_pass@localhost:5432/ai_contabil_db

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === JWT (SAME KEY as backend-project!) ===
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256

# === Encryption (32 bytes, base64 encoded) ===
# Generare: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY_DEFAULT=your-base64-encoded-32-byte-key

# === Server ===
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=3778

# === CORS ===
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:3777

# === Paths ===
MODEL_STORAGE_PATH=model_storage
TRAINING_DATA_PATH=training_data
UPLOAD_DIR=storage/uploads

# === Celery ===
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=logs/ai-service.log
